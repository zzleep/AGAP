# AGAP Environment Configuration Blueprint (.env.example)

# Supabase Configuration (Required for PWA Client & Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# OpenWeatherMap Integration (Required for Weather Cache & Flow Engine)
VITE_OPENWEATHER_API_KEY=your-openweather-api-key-here

# Backend / Supabase Edge Functions Secrets (DO NOT expose with VITE_ prefix)
GEMINI_API_KEY=your-gemini-api-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
